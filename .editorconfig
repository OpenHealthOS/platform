root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.cs]
dotnet_sort_system_directives_first = true
dotnet_style_require_accessibility_modifiers = always
csharp_style_namespace_declarations = file_scoped
dotnet_style_prefer_auto_properties = true
dotnet_style_object_initializer = true
dotnet_style_collection_initializer = true

# Keep initial analyzer noise manageable while still enforcing the rules.
dotnet_diagnostic.SA1633.severity = suggestion
dotnet_diagnostic.SA1600.severity = suggestion
dotnet_diagnostic.SA1505.severity = suggestion
dotnet_diagnostic.SA1508.severity = suggestion
dotnet_diagnostic.SA1518.severity = suggestion
dotnet_diagnostic.SA1201.severity = suggestion
dotnet_diagnostic.SA1202.severity = suggestion
dotnet_diagnostic.SA1309.severity = suggestion
dotnet_diagnostic.SA1101.severity = suggestion
